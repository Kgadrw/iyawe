# MongoDB
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/iyawe

# JWT
JWT_SECRET=your-secret-key

# SMTP (Gmail: use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-without-spaces
SMTP_FROM=Subizwa <your-email@gmail.com>

# Optional: separate inbox for admin match alerts (defaults to SMTP_USER)
# ADMIN_ALERT_EMAIL=admin@example.com

# Public app URL linked in alert emails
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
